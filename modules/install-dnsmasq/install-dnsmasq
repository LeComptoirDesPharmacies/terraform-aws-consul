#!/bin/bash
# Install Dnsmasq and configure it to forward requests for a specific domain to Consul. This script only supports
# Amazon Linux 2023.

set -e

readonly DEFAULT_CONSUL_DOMAIN="consul"
readonly DEFAULT_CONSUL_IP="127.0.0.1"
readonly DEFAULT_CONSUL_DNS_PORT=8600
readonly DEFAULT_DNSMASQ_LISTEN_ADDRESS=""

readonly DNS_MASQ_CONFIG_DIR="/etc/dnsmasq.d"
readonly CONSUL_DNS_MASQ_CONFIG_FILE="$DNS_MASQ_CONFIG_DIR/10-consul"

readonly RESOLV_CONF_SCRIPT="/usr/local/bin/consul-dnsmasq-resolv-conf"
readonly RESOLV_CONF_SERVICE_NAME="consul-dnsmasq-resolv-conf.service"
readonly RESOLV_CONF_SERVICE="/etc/systemd/system/$RESOLV_CONF_SERVICE_NAME"

readonly SCRIPT_NAME="$(basename "$0")"

function print_usage {
  echo
  echo "Usage: install-dnsmasq [OPTIONS]"
  echo
  echo "Install Dnsmasq and configure it to forward requests for a specific domain to Consul. This script only supports Amazon Linux 2023."
  echo
  echo "Options:"
  echo
  echo -e "  --consul-domain\tThe domain name to point to Consul. Optional. Default: $DEFAULT_CONSUL_DOMAIN."
  echo -e "  --consul-ip\t\tThe IP address to use for Consul. Optional. Default: $DEFAULT_CONSUL_IP."
  echo -e "  --consul-dns-port\tThe port Consul uses for DNS. Optional. Default: $DEFAULT_CONSUL_DNS_PORT."
  echo -e "  --dnsmasq-listen-address\t\tThe IP address for dnsmasq to listen on. Optional. Defaults to the value of --consul-ip."
  echo
  echo "Example:"
  echo
  echo "  install-dnsmasq"
}

function log {
  local -r level="$1"
  local -r message="$2"
  local -r timestamp=$(date +"%Y-%m-%d %H:%M:%S")
  >&2 echo -e "${timestamp} [${level}] [$SCRIPT_NAME] ${message}"
}

function log_info {
  local -r message="$1"
  log "INFO" "$message"
}

function log_warn {
  local -r message="$1"
  log "WARN" "$message"
}

function log_error {
  local -r message="$1"
  log "ERROR" "$message"
}

function assert_not_empty {
  local -r arg_name="$1"
  local -r arg_value="$2"

  if [[ -z "$arg_value" ]]; then
    log_error "The value for '$arg_name' cannot be empty"
    print_usage
    exit 1
  fi
}

function assert_amazon_linux_2023 {
  if ! grep -q '^ID="amzn"$' /etc/os-release 2>/dev/null || ! grep -q '^VERSION_ID="2023"$' /etc/os-release 2>/dev/null; then
    log_error "This script only supports Amazon Linux 2023."
    exit 1
  fi
}

# Amazon Linux 2023 replaced dhclient with systemd-networkd, so the "prepend domain-name-servers" entry in
# /etc/dhcp/dhclient.conf used on Amazon Linux 2 no longer has any effect. Instead, systemd-resolved keeps a
# generated resolv.conf in /run that /etc/resolv.conf is symlinked to: use that file as Dnsmasq's upstream and
# rewrite /etc/resolv.conf on every boot so that lookups go to Dnsmasq first.
function configure_resolv_conf {
  local -r consul_ip="$1"

  local -r resolved_resolv_conf="$(readlink -f /etc/resolv.conf)"
  if [[ "$resolved_resolv_conf" != /run/systemd/resolve/* ]]; then
    log_error "Expected /etc/resolv.conf to be a symlink into /run/systemd/resolve, but it points to '$resolved_resolv_conf'. Cannot configure DNS forwarding on this OS."
    exit 1
  fi

  log_info "Configuring Dnsmasq to forward all other lookups to the DNS servers in $resolved_resolv_conf"
  echo "resolv-file=$resolved_resolv_conf" | sudo tee -a "/etc/dnsmasq.conf" > /dev/null

  log_info "Configuring $RESOLV_CONF_SERVICE_NAME to point /etc/resolv.conf at Dnsmasq on every boot"
  sudo tee "$RESOLV_CONF_SCRIPT" > /dev/null <<EOF
#!/bin/bash
# Point /etc/resolv.conf at Dnsmasq, keeping the search domains and options systemd-resolved got from DHCP.
set -e
{
  echo "# Generated by install-dnsmasq: lookups go to Dnsmasq, which forwards to Consul and to the DNS servers in $resolved_resolv_conf."
  echo "nameserver $consul_ip"
  grep -E '^(search|domain|options) ' "$resolved_resolv_conf" || true
} > /etc/resolv.conf.dnsmasq
mv /etc/resolv.conf.dnsmasq /etc/resolv.conf
EOF
  sudo chmod +x "$RESOLV_CONF_SCRIPT"

  sudo tee "$RESOLV_CONF_SERVICE" > /dev/null <<EOF
[Unit]
Description=Point /etc/resolv.conf at Dnsmasq
Wants=systemd-resolved.service dnsmasq.service
After=systemd-resolved.service dnsmasq.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$RESOLV_CONF_SCRIPT

[Install]
WantedBy=multi-user.target
EOF
  sudo systemctl enable "$RESOLV_CONF_SERVICE_NAME"
}

function install_dnsmasq {
  local -r consul_ip="$1"

  log_info "Installing Dnsmasq"

  sudo dnf update -y
  sudo dnf install -y dnsmasq
  # conf-dir=$DNS_MASQ_CONFIG_DIR is already set in the stock /etc/dnsmasq.conf on Amazon Linux 2023.
  configure_resolv_conf "$consul_ip"
  sudo systemctl enable dnsmasq
}

function write_consul_config {
  local -r consul_domain="$1"
  local -r consul_ip="$2"
  local -r consul_port="$3"
  local -r dnsmasq_listen_address="$4"

  log_info "Configuring Dnsmasq to forward lookups of the '$consul_domain' domain on '$dnsmasq_listen_address' to $consul_ip:$consul_port in $CONSUL_DNS_MASQ_CONFIG_FILE"
  mkdir -p "$DNS_MASQ_CONFIG_DIR"

  sudo tee "$CONSUL_DNS_MASQ_CONFIG_FILE" <<EOF
# Enable forward lookup of the '$consul_domain' domain:
server=/${consul_domain}/${consul_ip}#${consul_port}

listen-address=${dnsmasq_listen_address}
bind-interfaces
EOF
}

function install {
  local consul_domain="$DEFAULT_CONSUL_DOMAIN"
  local consul_ip="$DEFAULT_CONSUL_IP"
  local consul_dns_port="$DEFAULT_CONSUL_DNS_PORT"
  local dnsmasq_listen_address="$DEFAULT_DNSMASQ_LISTEN_ADDRESS"

  while [[ $# -gt 0 ]]; do
    local key="$1"

    case "$key" in
      --consul-domain)
        assert_not_empty "$key" "$2"
        consul_domain="$2"
        shift
        ;;
      --consul-ip)
        assert_not_empty "$key" "$2"
        consul_ip="$2"
        shift
        ;;
      --consul-dns-port)
        assert_not_empty "$key" "$2"
        consul_dns_port="$2"
        shift
        ;;
      --dnsmasq-listen-address)
        assert_not_empty "$key" "$2"
        dnsmasq_listen_address="$2"
        shift
        ;;
      --help)
        print_usage
        exit
        ;;
      *)
        log_error "Unrecognized argument: $key"
        print_usage
        exit 1
        ;;
    esac

    shift
  done
  
  if [[ -z "$dnsmasq_listen_address" ]]; then
    dnsmasq_listen_address="$consul_ip"
  fi

  log_info "Starting Dnsmasq install"
  assert_amazon_linux_2023
  install_dnsmasq "$consul_ip"
  write_consul_config "$consul_domain" "$consul_ip" "$consul_dns_port" "$dnsmasq_listen_address"
  log_info "Dnsmasq install complete!"
}

install "$@"
